@startuml
'https://plantuml.com/class-diagram

' ===== Actors =====
class User {
    # userId : Long
    # username : String
    # password : String
    # age : int
    + login(username : String, password : String) : boolean
    + register(user : User) : User
}

class Manager {
    - quizList : List<Quiz>
    - questionLists : List<QuestionList>

    + createQuiz(list : QuestionList) : Quiz
    + updateQuiz(quizId : Long, quiz : Quiz) : Quiz
    + deleteQuiz(quizId : Long) : void
    + viewQuiz(quizId : Long) : Quiz

    + createQuestionList(list : QuestionList) : QuestionList
    + updateQuestionList(listId : Long, list : QuestionList) : QuestionList
    + deleteQuestionList(listId : Long, listId : Long) : void
    + viewQuestionList(listId : Long) : QuestionList

    + createQuestion(listId : Long, type : String, data : Map) : Question
    + importQuestions(file : String) : QuestionList
}

User <|-- Manager

class Student {
    - enrolledQuizzes : List<Quiz>
    + takeQuiz(quizId : Long, answers : List<String>) : int
    + viewResults(quizId : Long) : int
}

User <|-- Student

' ===== Question hierarchy =====
abstract class Question {
    - text : String
    - marks : int
    + display() : void
}

class MCQQuestion {
    - options : List<String>
    - correctOption : int
    + display() : void
}

class TrueFalseQuestion {
    - correctAnswer : boolean
    + display() : void
}

Question <|-- MCQQuestion
Question <|-- TrueFalseQuestion

' ===== Question Factory =====
class QuestionFactory {
    + createQuestion(type : String, data : Map) : Question
}

Manager --> QuestionFactory : uses >
QuestionFactory --> Question : creates >

' ===== QuestionList =====
class QuestionList {
    - questions : List<Question>
    + addQuestion(q : Question) : void
    + removeQuestion(qId : Long) : void
    + getQuestion(qId : Long) : Question
    + getQuestions() : List<Question>
}

QuestionList "1" *-- "0..*" Question : contains >
Manager "1" --> "0..*" QuestionList : manages >
Manager "1" --> "0..*" Quiz : manages >

' ===== CSV Parser =====
class CSVParser {
    + parse(filePath : String) : List<Map>
}

Manager --> CSVParser : uses >  ' simple CSV import

' ===== Strategy Pattern (Scoring) =====
interface ScoringStrategy {
    + calculateScore(correct : boolean) : int
}

class NormalScoring {
    + calculateScore(correct : boolean) : int
}

class NegativeScoring {
    - penalty : int
    + calculateScore(correct : boolean) : int
}

ScoringStrategy <|.. NormalScoring
ScoringStrategy <|.. NegativeScoring

' ===== Quiz =====
class Quiz {
    - questionList : QuestionList
    - scoringStrategy : ScoringStrategy
    + setScoringStrategy(strategy : ScoringStrategy) : void
    + evaluateAnswers(answers : List<String>) : int
}

Quiz --> ScoringStrategy : uses >
Quiz --> QuestionList : uses >

@enduml
