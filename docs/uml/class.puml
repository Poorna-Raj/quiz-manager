@startuml

class Question{
    - id : long
    - question : String
    - answer : String
    - marks : int
}

class Option{
    - id : long
    - option_text : String
}

Option "1..*" --* "1" Question : has

interface JpaRepository{
}

interface QuestionRepository{
}

JpaRepository <|-- QuestionRepository

class QuestionService{
    + createQuestion(question : Question) : Question
    + getQuestionById(long id) : Question
    + updateQuestionById(id : long, editedQuestion : Question) : Question
    + deleteQuestionById(id : long) : boolean
    + mapToQuestion(dto : QuestionRequestDto) : Question
    + mapToDto(question : Question) : QuestionResponseDto
    + checkAnswerInTheOptions(question : Question) : boolean
}

class QuestionResponseDto{
    - id : long
    - question : String
    - options : List<String>
    - marks : int
}

class QuestionRequestDto{
    - question : String
    - options : List<String>
    - answer : String
    - marks : int
}

QuestionService --> QuestionRepository : uses
QuestionService ..> Question : uses
QuestionService ..> QuestionRequestDto : uses
QuestionService ..> QuestionResponseDto : uses

class QuestionController{
    + createQuestion(dto : QuestionRequestDto) : ResponseEntity<QuestionResponseDto>
    + getQuestionById(id : long) : ResponseEntity<QuestionResponseDto>
    + updateQuestionById(id : long,dto : QuestionRequestDto) : ResponseEntity<QuestionResponseDto>
    + deleteQuestionById(id : long) : ResponseEntity<HttpStatus>
}

QuestionController --> QuestionService : uses
QuestionController ..> QuestionResponseDto : uses
QuestionController ..> QuestionRequestDto : uses

class User{
    - id : long
    - username : String
    - password : String
    - age : int
}

interface UserRepository{
}

UserRepository --|> JpaRepository

class UserService{
    + createUser(user : User) : User
    + updateUser(id : long, user : User) : User
    + getUserByUsername(username : String) : User
    + getUserById(id : long) : User
    + deleteUserById(id : long) : boolean
    + mapToDto(user : User) : UserResponseDto
    + mapToUser(dto : UserRequestDto) : User
}

UserService ..> User : uses

class UserResponseDto{
    - id : long
    - username : String
    - age : int
}

class UserRequestDto{
    - username : String
    - password : String
    - age : int
}

class UserLoginDto{
    - username : String
    - password : String
}

UserService --> UserRepository : uses
UserService ..> UserResponseDto : uses
UserService ..> UserRequestDto : uses

class UserController{
    + login(user : UserLoginDto) : ResponseEntity<UserResponseDto>
    + register(user : UserRequestDto) : ResponseEntity<UserResponseDto>
}

UserController --> UserService : uses
UserController ..> UserResponseDto : uses
UserController ..> UserRequestDto : uses
UserController ..> UserLoginDto : uses

class QuestionList{
    - id : long
    - topic : String
    - name : String
}

QuestionList "1" --* "0..*" Question : belongs to

interface QuestionListRepository{
}

QuestionListRepository --|> JpaRepository

class QuestionListRequestDto{
    - topic : String
    - name : String
}

class QuestionListResponseDto{
    - id : long
    - topic : String
    - name : String
    - questions_id : List<Long>
}

class QuestionListService{
    + createQuestionList(list : QuestionList) : QuestionList
    + updateQuestionList(id : long, list : QuestionList) : QuestionList
    + getAllQuestionList() : List<QuestionList>
    + deleteById(id : long) : boolean
    + clearAllQuestionsById(id : long) : QuestionList
    + getQuestionListById(id : long) : QuestionList
    + mapToModel(list : QuestionListRequestDto) : QuestionList
    + mapToDto(list : QuestionList) : QuestionListResponseDto
}

QuestionListService --> QuestionListRepository : uses
QuestionListService ..> QuestionList : uses
QuestionListService ..> QuestionListResponseDto : uses
QuestionListService ..> QuestionListRequestDto : uses

class QuestionListController{
    + createQuestionList(list : QuestionListRequestDto) : ResponseEntity<QuestionListResponseDto>
    + getQuestionListById(id : long) : ResponseEntity<QuestionListResponseDto>
    + getAllQuestionLists() : ResponseEntity<List<QuestionListResponseDto>>
    + updateById(id : long ,dto : QuestionListRequestDto) : ResponseEntity<QuestionListResponseDto>
    + deleteById(id : long) : ResponseEntity<HttpStatus>
    + deleteQuestionOnAListById(id : long) : ResponseEntity<QuestionListResponseDto>
}

QuestionListController --> QuestionListService : uses
QuestionListController ..> QuestionList : uses
QuestionListController ..> QuestionListRequestDto : uses
QuestionListController ..> QuestionListResponseDto : uses

@enduml